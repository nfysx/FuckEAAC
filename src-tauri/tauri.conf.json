{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuckEAAC",
  "version": "2.0.0",
  "identifier": "com.fuckeaac.desktop",

  "build": {
    "frontendDist": "../src"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FuckEAAC",
        "width": 1000,
        "height": 820,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
