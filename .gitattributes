# 统一行尾策略：仓库里一律存 LF，检出时按平台/类型决定
* text=auto

# 源码/文档/配置：LF
*.rs    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# 二进制：不要做任何转换
*.exe   binary
*.ico   binary
*.png   binary
